<% layout("layouts/boilerplate") %>

<style>
  .admin-code-shell {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background:
      radial-gradient(circle at top right, rgba(244, 63, 94, 0.12), transparent 35%),
      linear-gradient(180deg, #f8fafc 0%, #fff7ed 100%);
  }
  .admin-code-card {
    width: 100%;
    max-width: 460px;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 36px;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
  }
  .admin-code-input {
    width: 100%;
    border: 1px solid #cbd5e1;
    border-radius: 14px;
    padding: 16px 18px;
    font-size: 18px;
    letter-spacing: 4px;
    text-align: center;
    margin-bottom: 16px;
  }
  .admin-code-btn {
    width: 100%;
    border: none;
    border-radius: 14px;
    background: linear-gradient(135deg, #0f172a, #1e293b);
    color: white;
    padding: 15px;
    font-weight: 700;
  }
</style>

<div class="admin-code-shell">
  <div class="admin-code-card">
    <div style="width:64px; height:64px; border-radius:18px; background:#fee2e2; color:#be123c; display:flex; align-items:center; justify-content:center; font-size:28px; margin-bottom:20px;">
      <i class="fa-solid fa-shield-halved"></i>
    </div>

    <h2 style="margin:0 0 8px; font-weight:800;">Admin Security Check</h2>
    <p style="color:#64748b; margin-bottom:20px;">
      Enter the 12-digit code sent to <strong><%= pendingAdmin.email %></strong> to continue into the admin panel.
    </p>

    <form action="/login/admin/code" method="POST">
      <input
        type="text"
        name="securityCode"
        class="admin-code-input"
        placeholder="0000 0000 0000"
        maxlength="12"
        inputmode="numeric"
        pattern="\d{12}"
        required
      >
      <button class="admin-code-btn">Verify Admin Access</button>
    </form>

    <div style="margin-top:16px; font-size:12px; color:#94a3b8;">
      New admin accounts receive a fresh 12-digit code from the system when admin access is requested.
    </div>
  </div>
</div>
