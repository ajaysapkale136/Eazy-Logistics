<% layout("layouts/boilerplate") %>

<div class="container mt-5 profile-page <%= theme %>">

  <div class="glass-card profile-sidebar">
    <div class="text-center py-4">

      <img 
        src="<%= currUser?.profileImage?.url 
              || currUser?.profileImage?.[0]?.url
              || '/images/default-avatar.png' %>" 
        class="profile-photo-lg"
      >

      <h5 class="mt-2"><%= currUser?.username %></h5>
      <p class="small text-muted"><%= currUser?.email %></p>
    </div>

    <div class="p-3">
      <a href="/profile/me" class="menu-item"><i class="fa fa-user"></i> Profile Overview</a>
      <a href="/profile/edit" class="menu-item"><i class="fa fa-pen"></i> Edit Profile</a>
      <a href="/profile/listings" class="menu-item"><i class="fa fa-home"></i> My Listings</a>
      <a href="/profile/password" class="menu-item active"><i class="fa fa-lock"></i> Change Password</a>
      <a href="/profile/settings" class="menu-item"><i class="fa fa-cog"></i> Settings</a>
    </div>
  </div>

  <div class="glass-card profile-main hover-float">
    <h4>Change Password</h4>

    <form action="/profile/password?_method=PUT" method="POST">
      <div class="mb-3">
        <label class="form-label">Current password</label>
        <input type="password" name="currentPassword" class="form-control" required>
      </div>

      <div class="mb-3">
        <label class="form-label">New password</label>
        <input type="password" name="newPassword" class="form-control" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Confirm new password</label>
        <input type="password" name="confirmPassword" class="form-control" required>
      </div>

      <button class="btn btn-dark">Change Password</button>
    </form>
  </div>
</div>
