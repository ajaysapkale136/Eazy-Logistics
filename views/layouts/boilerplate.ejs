<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eazy-Logistics</title>
    <link rel="icon" type="image/svg+xml" href="/images/eazy-logistics-mark.svg">
    <link rel="shortcut icon" type="image/svg+xml" href="/images/eazy-logistics-mark.svg">
    <link rel="apple-touch-icon" href="/images/eazy-logistics-mark.svg">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#fe424d">

    <!-- CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <!-- FONTS -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;600;800&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">

    <!-- Rating + Mapbox -->
    <link rel="stylesheet" href="/css/rating.css">
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.14.0/mapbox-gl.css" rel="stylesheet">
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.14.0/mapbox-gl.js"></script>

    <!-- 🌍 Google Translate -->
    <script>
        function googleTranslateElementInit() {
            new google.translate.TranslateElement(
                {
                    pageLanguage: 'en',
                    includedLanguages: 'en,hi,mr,gu,bn,ta,te,kn,pa,ml,ur,ar,fr,es,de,it,ja,ko,zh-CN',
                    layout: google.translate.TranslateElement.InlineLayout.VERTICAL
                },
                'google_translate_element'
            );
        }
    </script>

    <script src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

</head>
<body
  class="<%= typeof theme !== 'undefined' ? theme : 'light' %>"
  data-server-theme="<%= typeof theme !== 'undefined' ? theme : 'light' %>"
  data-auth="<%= typeof currUser !== 'undefined' && currUser ? 'true' : 'false' %>"
>

  <!-- Navbar -->
  <%- include("../includes/navbar") %>

  <!-- Main Page Content -->
  <div class="container">
    <%- include("../includes/flash") %>
    <%- body %>
  </div>

  <!-- Footer -->
  <%- include("../includes/footer") %>

  <!-- 🌐 Floating Language Button -->
  <div id="langSwitcher" class="lang-switcher" onclick="toggleLangMenu()">
    🌐
  </div>

  <!-- Glassmorphism Translate Box -->
  <div id="langMenu" class="lang-menu glass-card">
    <div id="google_translate_element"></div>
  </div>

  <!-- Script: Toggle Language Menu -->
  <script>
    function toggleLangMenu() {
      const menu = document.getElementById("langMenu");
      menu.style.display = menu.style.display === "block" ? "none" : "block";
    }
  </script>

  <!-- Theme + Main Scripts -->
  <script src="/js/theme.js"></script>
  <script src="/js/script.js"></script>

</body>

</html>
